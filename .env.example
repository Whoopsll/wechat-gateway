# 复制成 .env 后手动载入：set -a; source .env; set +a
# .env 不会被 Python 自动读取。
WECHAT_ACCOUNT_ID='<bot-account-id>'
WECHAT_BASE_URL='https://ilinkai.weixin.qq.com'

# 沿用旧部署目录；可改成项目内 data/ 下的绝对路径。
WECHAT_WATCH_DIR="$HOME/workspace/wechat-watch"
WECHAT_STATE_DIR="$HOME/.openclaw/openclaw-weixin/accounts"

# 仅 send_mail 需要原运行环境提供的邮件 CLI。
WECHAT_MAIL_CLI='/opt/hatch/bin/hatch_gws_cli'
WECHAT_MAIL_ALLOWED='you@example.com'

# 仅 Hatch hook 需要；改成实际项目路径和虚拟环境解释器路径。
WECHAT_GATEWAY_SCRIPT="$HOME/workspace/wechat-watch/muse_wechat.py"
WECHAT_PYTHON='python3'
